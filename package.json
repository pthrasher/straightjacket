{
  "name": "straightjacket",
  "module": "src/index.ts",
  "type": "module",
  "private": true,
  "version": "2.1.9",
  "scripts": {
    "dev": "bun run src/index.ts",
    "clean": "rm dist/sj; rm -rf dist || true",
    "build": "bun clean && bun build --compile src/index.ts --outfile build/sj --external chokidar",
    "install-local": "bash scripts/mac-install.sh",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "test:integration": "SJ_INTEGRATION_TESTS=1 bun test",
    "docs:dev": "vitepress dev docs",
    "docs:build": "vitepress build docs",
    "docs:preview": "vitepress preview docs"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "vitepress": "^1.6.4"
  },
  "peerDependencies": {
    "typescript": "^5"
  },
  "dependencies": {
    "c12": "^4.0.0-beta.3",
    "citty": "^0.2.1",
    "defu": "^6.1.4"
  }
}
